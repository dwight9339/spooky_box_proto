@startuml InputResolutionSm
' InputResolution region: how presses, releases and turns resolve into gestures
' (decisions 0005 and 0009). Source of truth for CM7/App/sm/InputResolutionSm.[ch];
' regenerate with host/tools/behavior_model.py. Rules: docs/design/behavior/README.md.
' Guards and actions call only functions in CM7/App/sm/input_resolution_port.h.
'
' Every input event gets exactly one outcome: it emits a gesture to the Context
' region, it is absorbed into a press that resolves later, or it is swallowed. A
' release is interpreted with its press (decision 0009 item 1): the port records how
' each held control's press was resolved, and the release guards read that record.
' Per-control records hold data only; the layer the controls resolve in is a state.
'
' Guards read a classification the port takes before dispatch, so they give the
' same answer whatever actions run (README diagram rule 5).

[*] --> Resolving

state Resolving {
  [*] --> Neutral
  state Neutral
  state Shift {
    state ShiftReady
    state ShiftButton0
    state ShiftButton1
    state ShiftSpent
  }
  state Btn0Held {
    [*] --> Pending
    state Pending
    state Prompt {
      state StartPrompt
      state StopPrompt
    }
    state Consumed
  }
}

' --- Everywhere -----------------------------------------------------------------
' A release whose press was delivered emits its release; a pending Shift button
' action fires on its release even after Shift has ended (item 33); any other
' release is swallowed. Reconciliation releases every control and never fires an
' action (item 6).
Resolving : B0_RELEASE [inp_release_is(INP_RELEASE_SHIFT_PENDING)] / inp_fire_shift_release();
Resolving : B0_RELEASE [!inp_release_is(INP_RELEASE_SHIFT_PENDING)] / inp_swallow();
Resolving : B1_RELEASE [inp_release_is(INP_RELEASE_DELIVERED)] / inp_emit_release();
Resolving : B1_RELEASE [inp_release_is(INP_RELEASE_SHIFT_PENDING)] / inp_fire_shift_release();
Resolving : B1_RELEASE [inp_release_is(INP_RELEASE_SWALLOWED) || inp_release_is(INP_RELEASE_CLICK)] / inp_swallow();
Resolving : E_RELEASE / inp_swallow();
Resolving : E3_RELEASE / inp_swallow();
Resolving : TURN / inp_swallow();
Resolving --> Neutral : RECONCILE / inp_release_all();

' --- Normal layer ---------------------------------------------------------------
' Encoder presses become pending clicks or holds. Encoder 3 on an operating page is
' armed for Shift: the next press of another control enters Shift at once (item 23).
Neutral --> ShiftButton0 : B0_PRESS [inp_shift_armed()] / inp_cancel_pending(); inp_mark_shift_pending();
Neutral --> Pending : B0_PRESS [!inp_shift_armed() && inp_on_page()] / inp_cancel_pending(); inp_begin_session_hold();
Neutral : B0_PRESS [!inp_shift_armed() && !inp_on_page()] / inp_swallow();
Neutral --> ShiftButton1 : B1_PRESS [inp_shift_armed()] / inp_cancel_pending(); inp_mark_shift_pending();
Neutral : B1_PRESS [!inp_shift_armed()] / inp_emit_press();
Neutral --> ShiftSpent : E0_PRESS [inp_shift_armed()] / inp_cancel_pending(); inp_emit_shift();
Neutral : E0_PRESS [!inp_shift_armed()] / inp_begin_press();
Neutral --> ShiftReady : E_PRESS [inp_shift_armed()] / inp_cancel_pending(); inp_emit_shift();
Neutral : E_PRESS [!inp_shift_armed()] / inp_begin_press();
Neutral : E3_PRESS / inp_begin_press();
Neutral : E_RELEASE [inp_release_is(INP_RELEASE_CLICK)] / inp_emit_click();
Neutral : E3_RELEASE [inp_release_is(INP_RELEASE_CLICK)] / inp_emit_click();
' A turn cancels the pending click or hold of its own encoder (item 4).
Neutral : TURN / inp_cancel_turned_press(); inp_emit_turn();
' A hold cancels every other pending press (items 5 and 25). The armed Encoder 3
' hold enters Shift instead of emitting a gesture.
Neutral --> ShiftReady : HOLD [inp_hold_is_shift()] / inp_cancel_pending();
Neutral : HOLD [!inp_hold_is_shift()] / inp_emit_hold(); inp_cancel_pending();

' --- Shift layer ----------------------------------------------------------------
' Encoder turns and presses without a Shift action are swallowed (item 35). Releasing
' Encoder 3 ends Shift and never advances the page (item 24).
Shift : enter / inp_publish(INP_PUB_SHIFT_ENTERED);
Shift : exit / inp_publish(INP_PUB_SHIFT_LEFT);
Shift --> Neutral : E3_RELEASE / inp_swallow();
Shift : B0_PRESS / inp_swallow();
Shift : B1_PRESS / inp_swallow();
Shift : E0_PRESS / inp_swallow();
Shift : E_PRESS / inp_swallow();
Shift : E3_PRESS / inp_swallow();

' Encoder buttons fire on press (item 27). Encoder 0 opens the utility root, which
' changes context and spends Shift (item 34); Encoders 1 and 2 keep Shift active.
ShiftReady --> ShiftSpent : E0_PRESS / inp_emit_shift();
ShiftReady : E_PRESS / inp_emit_shift();
' Buttons 0 and 1 form one chord group (item 32): the first button waits for its
' release, and the second press fires the chord.
ShiftReady --> ShiftButton0 : B0_PRESS / inp_mark_shift_pending();
ShiftReady --> ShiftButton1 : B1_PRESS / inp_mark_shift_pending();
ShiftButton0 --> ShiftSpent : B1_PRESS / inp_fire_chord();
ShiftButton0 --> ShiftSpent : B0_RELEASE / inp_fire_shift_release();
ShiftButton1 --> ShiftSpent : B0_PRESS / inp_fire_chord();
ShiftButton1 --> ShiftReady : B1_RELEASE / inp_fire_shift_release();
' ShiftSpent: a mode switch, chord or utility entry fired; every press is swallowed
' until Encoder 3 is released.

' --- Button 0 session hold (decision 0005) --------------------------------------
' Everything is swallowed except releases whose press was delivered or is a pending
' Shift action, which the Resolving behaviors handle.
Btn0Held --> Neutral : B0_RELEASE / inp_swallow();
Btn0Held : B1_PRESS / inp_swallow();
Btn0Held : E0_PRESS / inp_swallow();
Btn0Held : E_PRESS / inp_swallow();
Btn0Held : E3_PRESS / inp_swallow();

' The session hold threshold has not been reached. A short press has no action.
Pending --> StartPrompt : B0_HOLD [!inp_session_active()]
Pending --> StopPrompt : B0_HOLD [inp_session_active()]

' The prompt is open. Encoder 0 button confirms, releasing Button 0 cancels, and
' everything else is dismissed. Feedback on the outcome comes from the Session region.
StartPrompt : enter / inp_publish(INP_PUB_PROMPT_OPENED_START);
StopPrompt : enter / inp_publish(INP_PUB_PROMPT_OPENED_STOP);
StartPrompt --> Consumed : E0_PRESS / inp_swallow(); inp_publish(INP_PUB_PROMPT_CONFIRMED_START); inp_issue(INP_CMD_START_SESSION);
StopPrompt --> Consumed : E0_PRESS / inp_swallow(); inp_publish(INP_PUB_PROMPT_CONFIRMED_STOP); inp_issue(INP_CMD_STOP_SESSION);
Prompt --> Neutral : B0_RELEASE / inp_swallow(); inp_publish(INP_PUB_PROMPT_CANCELLED);
Prompt --> Neutral : RECONCILE / inp_publish(INP_PUB_PROMPT_CANCELLED); inp_release_all();
Prompt --> Consumed : SESSION_CHANGED / inp_publish(INP_PUB_PROMPT_WITHDRAWN);

' Consumed: the prompt closed without being cancelled; the rest of the hold is swallowed.

note right of Pending
  Which prompt opens in Armed or Reviewing:
  full_spooky_proto-hpq.2, full_spooky_proto-hpq.3.
  Hold thresholds stay configurable until bench
  trials set them (decision 0009 item 7).
end note

/'! $CONFIG : toml
[RenderConfig.C]
IncludeGuardLabel = "SPOOKY_INPUT_RESOLUTION_SM_H"
CFileIncludes = """
    #include "input_resolution_port.h"
    """
'/
@enduml
